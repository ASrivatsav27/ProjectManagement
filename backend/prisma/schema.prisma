generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  ProjectManager
  TeamMember
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      Role     @default(TeamMember)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


